{
  "name": "hull",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "next build",
    "build:studio": "cd studio && npx sanity build ../public/studio -y",
    "dev:studio": "cd studio && yarn && yarn dev",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
